NODE_ENV="production"
PORT=5000

# Postgres cloud (Aiven/Neon/Railway...). Them uselibpqcompat=true neu chi co
# sslmode=require, vi pg v8 se ep verify-full va bao self-signed certificate.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require&uselibpqcompat=true"

# Domain frontend da deploy - dung cho CORS va cookie refresh token.
CLIENT_URL="https://your-frontend.vercel.app"
# Nhieu domain: CLIENT_URL="https://a.vercel.app,https://b.com"

JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
