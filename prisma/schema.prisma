generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AssignmentType {
  QUIZ
  PRACTICAL
}

enum AssignmentStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  password          String
  name              String
  avatar            String?
  role              UserRole       @default(STUDENT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  taughtClasses     Class[]        @relation("InstructorClasses")
  classMembers      ClassMember[]
  submissions       Submission[]
  gradedSubmissions Submission[]   @relation("GradedBy")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id           String        @id @default(cuid())
  title        String
  description  String?
  instructorId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  instructor   User          @relation("InstructorClasses", fields: [instructorId], references: [id])
  members      ClassMember[]
  sessions     Session[]
}

model ClassMember {
  id        String   @id @default(cuid())
  userId    String
  classId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

model Session {
  id          String       @id @default(cuid())
  title       String
  sessionDate DateTime
  recordLink  String?
  classId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model Assignment {
  id              String           @id @default(cuid())
  title           String
  description     String?          @db.Text
  type            AssignmentType
  sessionId       String
  durationMinutes Int?
  openAt          DateTime?
  closeAt         DateTime?
  maxScore        Float            @default(10)
  status          AssignmentStatus @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questions       Question[]
  submissions     Submission[]
}

model Question {
  id            String     @id @default(cuid())
  assignmentId  String
  question      String
  options       Json
  correctAnswer Int
  order         Int
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  status       SubmissionStatus @default(IN_PROGRESS)
  startedAt    DateTime?
  submittedAt  DateTime?
  expiresAt    DateTime?
  score        Float?
  answers      Json?
  fileUrl      String?
  submitLink   String?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy     User?            @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([assignmentId, userId])
}
