# Postgres cloud (Aiven/Neon...) yeu cau SSL: them uselibpqcompat=true de pg v8
# khong ep verify-full khi chi co sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning_db?schema=public"
JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Nhieu domain thi ngan cach bang dau phay. O dev, moi cong localhost deu
# duoc chap nhan (Vite tu nhay sang 5174, 5175... khi cong bi chiem).
CLIENT_URL="http://localhost:5173"
PORT=5000
NODE_ENV=development
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
